#pragma once

// Aurora, after Baranoski, Rokne, Shirley, Trondsen & Bastos, "Simulating the
// aurora", J. Visual. Comput. Animat. 14 (2003).
//
// The paper traces electron beams down the field lines of a sheet whose
// boundaries are a pair of phase-shifted sine waves, splats their emission
// points onto the image and blurs each spectral line by its excited state's
// lifetime. That is a forward, image-space method and this is a per-ray sky
// evaluator, so the same model is expressed here as a volume the view ray is
// integrated through:
//
//   - the sheet is the paper's, in the horizontal plane at the lower border:
//     two sine boundaries a fixed phase apart, bent by the rotational
//     distortions it lists (folds about 20 km apart, spirals about 50);
//   - a point above the lower border belongs to the sheet position its field
//     line descends to, which is what makes rays field-aligned and makes them
//     converge on the magnetic zenith as a corona;
//   - emission against height is one profile per line - 557.7 nm green low and
//     sharp-bottomed, 427.8 nm blue at the lower border, 630.0 nm red high and
//     broad;
//   - the per-line blur becomes a per-line sheet thickness, widest for red
//     (110 s lifetime), slight for green (0.7 s), none for blue.
//
// The sheet is a few kilometres thick and the shell it lives in is hundreds,
// so it is never point-sampled: across each step the distance to the sheet is
// taken as linear and the Gaussian cross-section integrated in closed form.
// That is also what gives the paper's Figure 6 for free - apparent brightness
// follows the thickness of curtain along the line of sight, so folds seen
// edge-on become the bright vertical streaks.

#include "rtx/pass/atmosphere/aurora_model.h"

// Width of a single ray along the arc, and of the bundles rays gather into, km.
static const float kAuroraRayWidthKm = 1.3f;
static const float kAuroraBundleWidthKm = 12.0f;

// Near the sheet a step is cut into pieces no longer than a fold can hide in.
// kAuroraFoldReachKm is how far a fold can carry the sheet from where a step's
// ends find it; pieces shorter than kAuroraRefineStepKm need no closing in.
static const float kAuroraFoldStepKm = 3.0f;
static const float kAuroraFoldReachKm = 8.0f;
static const uint kAuroraMaxPieces = 8u;
static const float kAuroraRefineStepKm = 2.0f;

// How many widths out a line's glow is followed. The cut is a hard one that
// lands on step boundaries, so it has to fall where nothing is left to see:
// 0.03% at four, against a visibly serrated 1% at three.
static const float kAuroraGlowSigmas = 4.0f;

// Phase shift between the sheet's two boundaries; the paper's upper bound.
static const float kAuroraBoundaryPhase = 0.35f * 3.14159265f;

float auroraHash(float n, float seed) {
  return hash31(vec3(n, seed, 7.0f));
}

float auroraNoise1D(float x, float seed) {
  const float i = floor(x);
  float f = x - i;
  // Quintic: the ray silhouettes are this curve, and a kink in its slope shows.
  f = f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);
  return mix(auroraHash(i, seed), auroraHash(i + 1.0f, seed), f);
}

// Abramowitz & Stegun 7.1.27, |error| < 5e-4.
float auroraErf(float x) {
  const float a = abs(x);
  float d = 1.0f + a * (0.278393f + a * (0.230389f + a * (0.000972f + a * 0.078108f)));
  d *= d;
  d *= d;
  return sign(x) * (1.0f - 1.0f / d);
}

// Mean of exp(-f^2 / 2 sigma^2) along a segment over which f runs linearly
// from f0 to f1. The erf form loses its precision to cancellation when the
// segment barely moves across the sheet, which is exactly the edge-on case, so
// that range is integrated numerically instead.
float auroraSlabMean(float f0, float f1, float sigma) {
  const float inv = 0.70710678f / sigma;
  const float a = f0 * inv;
  const float b = f1 * inv;
  const float d = b - a;
  if (abs(d) < 0.5f) {
    const float m = 0.5f * (a + b);
    return (exp(-a * a) + 4.0f * exp(-m * m) + exp(-b * b)) * (1.0f / 6.0f);
  }
  return 0.88622693f * (auroraErf(b) - auroraErf(a)) / d;
}

// Path-averaged cross-section of the sheet for the blue, green and red lines
// (x, y, z), each a unit-area Gaussian of its own width. Unit area is what
// makes a line that spreads further dimmer by the same factor, and a sheet
// crossed square-on at a line's peak return the stated brightness.
vec3 auroraCrossSections(float f0, float f1, vec3 sigmas) {
  const float kInvSqrtTwoPi = 0.39894228f;
  return kInvSqrtTwoPi * vec3(auroraSlabMean(f0, f1, sigmas.x),
                              auroraSlabMean(f0, f1, sigmas.y),
                              auroraSlabMean(f0, f1, sigmas.z)) / sigmas;
}

// Chapman production profile: a sharp lower edge and an exponential top, with
// separate scale heights either side of the peak.
float auroraHeightProfile(float h, float peak, float below, float above) {
  const float y = max((h - peak) / (h < peak ? below : above), -8.0f);
  return exp(1.0f - y - exp(-y));
}

// Where the arc's centreline sits across the arc at along-arc position u. The
// arcs of a system move together, so the seed only nudges the phase.
float auroraCentreline(float u, float base, float seed, float time, float activity) {
  const float wander = 0.5f + activity;
  return base
       + 35.0f * wander * sin(u * (6.2831853f / 620.0f) + seed * 0.4f + time * 0.005f)
       + 10.0f * wander * sin(u * (6.2831853f / 173.0f) - seed * 0.7f - time * 0.02f);
}

// One family of rotational distortions: vortices spaced along the arc and
// travelling along it, each winding the sheet about a point on its centreline.
// The rotation decays with distance, so the sheet is wound differentially into
// an S rather than turned rigidly.
vec2 auroraDistort(vec2 q, float spacing, float speed, float maxAngle,
                   float base, float seed, float time, float activity) {
  const float travel = speed * time;
  const float x = (q.x - travel) / spacing;
  const float cell = floor(x);
  const float local = x - cell - 0.5f;

  vec2 centre;
  centre.x = (cell + 0.5f) * spacing + travel;
  centre.y = auroraCentreline(centre.x, base, seed, time, activity);

  // Zero at the cell boundary, so neighbouring vortices meet without a seam.
  float window = 1.0f - 4.0f * local * local;
  window *= window;

  float strength = auroraHash(cell, seed + spacing) * 2.0f - 1.0f;
  strength *= abs(strength);

  const vec2 d = q - centre;
  const float radius = 0.28f * spacing;
  const float angle = maxAngle * strength * window * exp(-dot(d, d) / (radius * radius));
  const float c = cos(angle);
  const float s = sin(angle);
  return centre + vec2(d.x * c - d.y * s, d.x * s + d.y * c);
}

struct AuroraSheetSample {
  float offset;     // signed distance across the sheet from its centre, km
  float sigma;      // Gaussian half-width of the sheet here, km
  float along;      // distorted along-arc coordinate, km
  float altitude;   // km
};

struct AuroraFrame {
  vec2 east;        // along-arc axis in the atmosphere's XZ plane
  vec2 poleward;    // across-arc axis, toward the magnetic pole
  float eyeRadius;
  float time;
  float activity;
};

float auroraAltitude(float t, float dirY, float eyeRadius) {
  const float x = t * (2.0f * eyeRadius * dirY + t);
  return x / (sqrt(eyeRadius * eyeRadius + x) + eyeRadius);
}

float auroraShellDistance(float altitude, float dirY, float eyeRadius) {
  const float b = eyeRadius * dirY;
  return -b + sqrt(b * b + altitude * (2.0f * eyeRadius + altitude));
}

// The view ray's position in sheet coordinates: horizontal position slid down
// its field line to the lower border.
vec2 auroraFootprint(vec3 dir, float t, float altitude, AuroraFrame frame, AtmosphereArgs args) {
  const vec2 horizontal = dir.xz * t;
  return vec2(dot(horizontal, frame.east),
              dot(horizontal, frame.poleward)
                + (altitude - args.auroraLowerBorderKm) * args.auroraFieldTanTilt);
}

AuroraSheetSample auroraSampleSheet(vec3 dir, float t, float base, float seed,
                                    AuroraFrame frame, AtmosphereArgs args) {
  AuroraSheetSample s;
  s.altitude = auroraAltitude(t, dir.y, frame.eyeRadius);

  vec2 q = auroraFootprint(dir, t, s.altitude, frame, args);
  const float winding = args.auroraFoldStrength * (0.4f + 1.2f * frame.activity);
  q = auroraDistort(q, 55.0f, 0.4f, 1.6f * winding, base, seed, frame.time, frame.activity);
  q = auroraDistort(q, 21.0f, 1.8f, 2.6f * winding, base, seed, frame.time, frame.activity);

  const float thickness = args.auroraSheetThicknessKm;
  const float wavelength = 2.0f * thickness * args.auroraSheetWavelengthRatio;
  const float theta = q.x * (6.2831853f / wavelength) + seed * 1.7f + frame.time * 0.15f;
  const float lower = sin(theta);
  const float upper = sin(theta + kAuroraBoundaryPhase);

  // Boundary amplitude 0.6 of the thickness: the largest that keeps the two
  // boundaries from crossing at this phase shift.
  const float centre = auroraCentreline(q.x, base, seed, frame.time, frame.activity)
                     + 0.3f * thickness * (lower + upper);
  const float localThickness = thickness * max(1.0f + 0.6f * (upper - lower), 0.3f);

  s.offset = q.y - centre;
  s.sigma = localThickness * (1.0f / 2.355f);
  s.along = q.x;
  return s;
}

// Fraction along the segment from a to b at which it is nearest the sheet: the
// crossing, else the nearer end, else the middle when it runs alongside.
float auroraNearestApproach(AuroraSheetSample a, AuroraSheetSample b) {
  const float approach = a.offset - b.offset;
  return abs(approach) > 0.05f * a.sigma ? saturate(a.offset / approach) : 0.5f;
}

// Light emitted along one piece of the view ray, between two samples of an
// arc's sheet, in cd/m^2 per kR of green.
vec3 auroraSegment(vec3 dir, AuroraSheetSample prev, AuroraSheetSample cur, float tPrev, float t,
                   float base, float seed, AuroraFrame frame, AtmosphereArgs args) {
  const float lowerBorder = args.auroraLowerBorderKm;
  const float sigma = 0.5f * (prev.sigma + cur.sigma);
  const float sigmaGreen = 1.15f * sigma;
  const float sigmaRed = 3.0f * sigma + 4.0f;
  const bool crosses = prev.offset * cur.offset < 0.0f;

  const float clearance = min(abs(prev.offset), abs(cur.offset));

  if (crosses || clearance < kAuroraGlowSigmas * sigmaRed) {
    const vec3 sigmas = vec3(sigma, sigmaGreen, sigmaRed);
    AuroraSheetSample low = prev;
    AuroraSheetSample high = cur;
    float tLow = tPrev;
    float tHigh = t;
    vec3 crossSection = vec3(0.0f);

    // A fold bends the sheet within a step, so a step that crosses it is
    // closed in on the crossing and the pieces integrated separately. The
    // ends of a whole step misplace the crossing by an amount that slides
    // with the step phase, which shows as a ripple along every ray.
    //
    // False position with the Illinois correction: halving the estimate at
    // an end that is kept twice running is what makes both ends close in.
    if (crosses && t - tPrev > kAuroraRefineStepKm) {
      float estimateLow = low.offset;
      float estimateHigh = high.offset;
      int kept = 0;
      for (uint refine = 0u; refine < 3u; ++refine) {
        const float tMid = mix(tLow, tHigh, clamp(estimateLow / (estimateLow - estimateHigh), 0.02f, 0.98f));
        const AuroraSheetSample mid = auroraSampleSheet(dir, tMid, base, seed, frame, args);

        if (mid.offset * low.offset < 0.0f) {
          crossSection += auroraCrossSections(mid.offset, high.offset, sigmas) * (tHigh - tMid);
          tHigh = tMid;
          high = mid;
          estimateHigh = mid.offset;
          estimateLow *= kept < 0 ? 0.5f : 1.0f;
          kept = -1;
        } else {
          crossSection += auroraCrossSections(low.offset, mid.offset, sigmas) * (tMid - tLow);
          tLow = tMid;
          low = mid;
          estimateLow = mid.offset;
          estimateHigh *= kept > 0 ? 0.5f : 1.0f;
          kept = 1;
        }
      }
    }
    crossSection += auroraCrossSections(low.offset, high.offset, sigmas) * (tHigh - tLow);

    // Emission is read where what is left of the step comes closest to the sheet.
    const float where = auroraNearestApproach(low, high);
    const float altitude = mix(low.altitude, high.altitude, where);
    const float along = mix(low.along, high.along, where);
    const float distance = mix(tLow, tHigh, where);

    // Rays gather into bundles. A bundle sets how tall the curtain stands
    // and how bright it is; the rays inside it only streak its brightness.
    // Letting single rays set the height draws each one as a wedge.
    const float b = along / kAuroraBundleWidthKm - frame.time * (0.02f + 0.06f * frame.activity);
    const float bundle = smoothstep(0.2f, 0.8f, 0.6f * auroraNoise1D(b, seed) + 0.4f * auroraNoise1D(b * 0.31f + 40.0f, seed + 1.0f));

    // Single rays are about a kilometre across and a far curtain puts
    // several under one pixel, so they fade to their mean as they shrink.
    const float pixelKm = distance * args.pixelAngleRad;
    const float kStrandsPerRay = 0.37f;
    const float resolvedRay = saturate(1.5f - 2.0f * pixelKm / kAuroraRayWidthKm);
    const float resolvedStrand = saturate(1.5f - 2.0f * pixelKm * kStrandsPerRay / kAuroraRayWidthKm);
    const float r = along / kAuroraRayWidthKm - frame.time * (1.5f + 4.0f * frame.activity);
    const float streak = 0.6f * mix(0.5f, auroraNoise1D(r * kStrandsPerRay + 11.0f, seed + 3.0f), resolvedStrand)
                       + 0.4f * mix(0.5f, auroraNoise1D(r, seed + 4.0f), resolvedRay);
    const float rayGain = mix(1.0f, (0.35f + 1.3f * bundle) * (0.6f + 0.8f * streak), args.auroraRayStrength);
    const float surge = 0.35f + 1.3f * auroraNoise1D(along * (1.0f / 90.0f) - frame.time * 0.02f, seed + 2.0f);

    const float extent = args.auroraVerticalExtentKm * (1.0f + AURORA_RAY_EXTENT_GAIN * args.auroraRayStrength * bundle);
    const float green = auroraHeightProfile(altitude, lowerBorder + AURORA_GREEN_PEAK_KM,
                                            AURORA_GREEN_BELOW_KM, extent);
    const float blue = auroraHeightProfile(altitude, lowerBorder + AURORA_BLUE_PEAK_KM,
                                           AURORA_BLUE_BELOW_KM, AURORA_BLUE_EXTENT * extent);
    const float red = auroraHeightProfile(altitude, lowerBorder + AURORA_RED_PEAK_KM,
                                          AURORA_RED_BELOW_KM, AURORA_RED_ABOVE_KM);

    return surge * (AURORA_BLUE_PER_KR  * (crossSection.x * args.auroraBlueRatio * blue * rayGain)
                  + AURORA_GREEN_PER_KR * (crossSection.y * green * rayGain)
                  + AURORA_RED_PER_KR   * (crossSection.z * args.auroraRedRatio * red * mix(1.0f, rayGain, 0.3f)));
  }
  return vec3(0.0f);
}

// Radiance of the aurora along a view direction in the atmosphere's Y-up frame,
// in frame units.
vec3 evalAurora(vec3 dir, AtmosphereArgs args, NightRadiometry rad) {
  if (args.auroraIntensityKR <= 0.0f || rad.adaptation <= 0.0f || dir.y <= 0.0f) {
    return vec3(0.0f);
  }

  AuroraFrame frame;
  frame.poleward = args.auroraPolewardXZ;
  frame.east = vec2(frame.poleward.y, -frame.poleward.x);
  frame.eyeRadius = getEyeRadius(args);
  frame.time = args.auroraTimeSeconds;
  frame.activity = args.auroraActivity;

  const float lowerBorder = args.auroraLowerBorderKm;
  const float rayedExtent = args.auroraVerticalExtentKm * (1.0f + AURORA_RAY_EXTENT_GAIN * args.auroraRayStrength);
  float top = lowerBorder + AURORA_GREEN_PEAK_KM + 5.0f * rayedExtent;
  if (args.auroraRedRatio > 0.0f) {
    top = max(top, lowerBorder + AURORA_RED_PEAK_KM + 2.0f * AURORA_RED_ABOVE_KM);
  }

  const float tNear = auroraShellDistance(max(lowerBorder - 2.0f, 1.0f), dir.y, frame.eyeRadius);
  const float tFar = auroraShellDistance(top, dir.y, frame.eyeRadius);

  const uint maxSteps = max(args.auroraViewSamples, 6u);
  const uint arcCount = min(args.auroraArcCount, AURORA_MAX_ARCS);

  // The footprint's across-arc coordinate runs almost linearly along the ray,
  // and the sheet never strays further than this from its arc's base line, so
  // each arc can only be met inside one short stretch of the shell. Marching
  // that stretch alone is most of the cost saved and all of the steps spent
  // where the curtain is.
  const float acrossNear = auroraFootprint(dir, tNear, lowerBorder, frame, args).y;
  const float acrossFar = auroraFootprint(dir, tFar, top, frame, args).y;
  const float acrossRate = (acrossFar - acrossNear) / max(tFar - tNear, 1e-3f);
  const float widestSigma = 1.6f * args.auroraSheetThicknessKm * (1.0f / 2.355f);
  const float glowReach = kAuroraGlowSigmas * (args.auroraRedRatio > 0.0f ? 3.0f * widestSigma + 4.0f : 1.15f * widestSigma);
  const float kWindingAndCurvatureKm = 25.0f;
  const float reach = 45.0f * (0.5f + frame.activity) + args.auroraSheetThicknessKm
                    + glowReach + kWindingAndCurvatureKm;

  vec3 total = vec3(0.0f);
  for (uint k = 0u; k < arcCount; ++k) {
    const float seed = float(k) * 3.0f + 1.0f;
    const float base = args.auroraDistanceKm
                     + (float(k) - 0.5f * float(arcCount - 1u)) * args.auroraArcSpacingKm;

    float tBegin = tNear;
    float tEnd = tFar;
    if (abs(acrossRate) * (tFar - tNear) > 1.0f) {
      const float tA = tNear + (base - reach - acrossNear) / acrossRate;
      const float tB = tNear + (base + reach - acrossNear) / acrossRate;
      tBegin = max(tNear, min(tA, tB));
      tEnd = min(tFar, max(tA, tB));
    } else if (abs(acrossNear - base) > reach) {
      continue;
    }
    if (tEnd <= tBegin) {
      continue;
    }

    const uint steps = clamp(uint(ceil(float(maxSteps) * (tEnd - tBegin) / (tFar - tNear))),
                             min(6u, maxSteps), maxSteps);
    // From the bottom of the shell the steps crowd toward the lower border,
    // where the height profile is sharp; elsewhere the march closes in on the sheet.
    const float spacingPower = tBegin == tNear ? 2.0f : 1.0f;

    vec3 arc = vec3(0.0f);
    float tPrev = tBegin;
    AuroraSheetSample prev = auroraSampleSheet(dir, tBegin, base, seed, frame, args);
    for (uint i = 1u; i <= steps; ++i) {
      const float t = mix(tBegin, tEnd, pow(float(i) / float(steps), spacingPower));
      const AuroraSheetSample cur = auroraSampleSheet(dir, t, base, seed, frame, args);

      // Within a fold's reach of the sheet a whole step can hold a fold: the
      // ray may graze the sheet or cross it three times, and which of those the
      // step's two ends happen to see changes with the step phase, breaking
      // every ray edge into rungs. There the step is cut to the fold's scale.
      const float foldReach = kAuroraFoldReachKm + max(prev.sigma, cur.sigma);
      const bool nearSheet = prev.offset * cur.offset < 0.0f
                          || min(abs(prev.offset), abs(cur.offset)) < foldReach;
      const uint pieces = nearSheet
                        ? clamp(uint(ceil((t - tPrev) / kAuroraFoldStepKm)), 1u, kAuroraMaxPieces)
                        : 1u;

      AuroraSheetSample from = prev;
      float tFrom = tPrev;
      for (uint piece = 1u; piece < pieces; ++piece) {
        const float tTo = mix(tPrev, t, float(piece) / float(pieces));
        const AuroraSheetSample to = auroraSampleSheet(dir, tTo, base, seed, frame, args);
        arc += auroraSegment(dir, from, to, tFrom, tTo, base, seed, frame, args);
        from = to;
        tFrom = tTo;
      }
      arc += auroraSegment(dir, from, cur, tFrom, t, base, seed, frame, args);

      prev = cur;
      tPrev = t;
    }
    total += arc * AURORA_ARC_BRIGHTNESS(k);
  }

  const vec3 extinction = getAtmosphericTransmittanceForDir(dir, args);
  return total * extinction * (args.auroraIntensityKR * rad.framePerLux * rad.gain);
}
