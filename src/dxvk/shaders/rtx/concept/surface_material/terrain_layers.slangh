#pragma once

// Layered terrain: evaluates a terrain chunk's layers at a hit from the game's own layer textures
// and coverage masks, in the order and with the blend the game composites them in, instead of
// reading the resampled terrain cascade. The chunks and layers are read from the table texture
// described beside TerrainLayerArgs.
//
// A layer's coverage is its mask (times the colour texture's alpha where flagged), dropped when
// not greater than the layer's alpha reference; each layer then composites over the ones before
// it. The few layers left with a visible weight are sampled, each through its own planar
// projection of the object-space position.

struct TerrainLayerBlend
{
  bool valid;
  // Linear.
  vec3 albedo;
  // World space.
  vec3 normal;
  float normalDetail;
  float roughness;
  float metallic;
};

struct TerrainLayerChunk
{
  // Rows of the world-to-object transform.
  vec4 worldToObject[3];
  vec3 projectionOrigin;
  float maskScale;
  uint firstLayer;
  uint layerCount;
};

struct TerrainLayer
{
  vec3 texcoordU;
  vec3 texcoordV;
  uint colorTextureIndex;
  uint normalTextureIndex;
  uint roughnessTextureIndex;
  uint metallicTextureIndex;
  uint maskTextureIndex;
  uint samplerIndex;
  uint flags;
};

// The colour texture coordinates of a layer and their footprint.
struct TerrainLayerTexcoords
{
  vec2 texcoord;
  vec2 gradientX;
  vec2 gradientY;
};

vec4 terrainLayerTableRead(uint texel)
{
  return textures[nonuniformEXT(cb.terrainLayerArgs.tableTextureIndex)].Load(
    int3(texel % kTerrainLayerTableWidth, texel / kTerrainLayerTableWidth, 0));
}

vec3 terrainLayerChunkPoint(TerrainLayerChunk chunk, vec3 worldPosition)
{
  const vec4 p = vec4(worldPosition, 1.0);
  return vec3(dot(chunk.worldToObject[0], p), dot(chunk.worldToObject[1], p), dot(chunk.worldToObject[2], p));
}

vec3 terrainLayerChunkDirection(TerrainLayerChunk chunk, vec3 worldDirection)
{
  return vec3(dot(chunk.worldToObject[0].xyz, worldDirection), dot(chunk.worldToObject[1].xyz, worldDirection),
              dot(chunk.worldToObject[2].xyz, worldDirection));
}

// The world-space direction along which an object-space coordinate direction increases: the
// object-space gradient taken through the transpose of the world-to-object transform.
vec3 terrainLayerChunkGradient(TerrainLayerChunk chunk, vec3 objectGradient)
{
  return chunk.worldToObject[0].xyz * objectGradient.x + chunk.worldToObject[1].xyz * objectGradient.y +
         chunk.worldToObject[2].xyz * objectGradient.z;
}

uint terrainLayerFlagsRead(uint layerIndex)
{
  const vec4 packed = terrainLayerTableRead(cb.terrainLayerArgs.layerOffset + layerIndex * kTerrainLayerTexels + 3);
  return uint(packed.x) | (uint(packed.y) << 24);
}

uint terrainLayerMaskTextureRead(uint layerIndex)
{
  return uint(terrainLayerTableRead(cb.terrainLayerArgs.layerOffset + layerIndex * kTerrainLayerTexels + 2).z);
}

TerrainLayer terrainLayerRead(uint layerIndex)
{
  const uint texel = cb.terrainLayerArgs.layerOffset + layerIndex * kTerrainLayerTexels;
  const vec4 u = terrainLayerTableRead(texel);
  const vec4 v = terrainLayerTableRead(texel + 1);
  const vec4 indices = terrainLayerTableRead(texel + 2);

  TerrainLayer layer;
  layer.texcoordU = u.xyz;
  layer.texcoordV = v.xyz;
  layer.colorTextureIndex = uint(u.w);
  layer.normalTextureIndex = uint(v.w);
  layer.roughnessTextureIndex = uint(indices.x);
  layer.metallicTextureIndex = uint(indices.y);
  layer.maskTextureIndex = uint(indices.z);
  layer.samplerIndex = uint(indices.w);
  layer.flags = terrainLayerFlagsRead(layerIndex);
  return layer;
}

vec2 terrainLayerProject(uint flags, vec3 v)
{
  const uint projection = (flags >> TERRAIN_LAYER_PROJECTION_SHIFT) & TERRAIN_LAYER_PROJECTION_MASK;
  return projection == 0 ? v.xz : (projection == 1 ? v.xy : v.zy);
}

// The object-space direction a projected coordinate (a, b) increases along.
vec3 terrainLayerUnproject(uint flags, vec2 v)
{
  const uint projection = (flags >> TERRAIN_LAYER_PROJECTION_SHIFT) & TERRAIN_LAYER_PROJECTION_MASK;
  return projection == 0 ? vec3(v.x, 0, v.y) : (projection == 1 ? vec3(v.x, v.y, 0) : vec3(0, v.y, v.x));
}

TerrainLayerTexcoords terrainLayerTexcoords(
  TerrainLayer layer, vec3 projectedPosition, vec3 objectEllipseAxis0, vec3 objectEllipseAxis1)
{
  const vec2 position = terrainLayerProject(layer.flags, projectedPosition);
  const vec2 axis0 = terrainLayerProject(layer.flags, objectEllipseAxis0);
  const vec2 axis1 = terrainLayerProject(layer.flags, objectEllipseAxis1);

  TerrainLayerTexcoords texcoords;
  texcoords.texcoord = vec2(dot(vec3(position, 1), layer.texcoordU), dot(vec3(position, 1), layer.texcoordV));
  texcoords.gradientX = vec2(dot(axis0, layer.texcoordU.xy), dot(axis0, layer.texcoordV.xy));
  texcoords.gradientY = vec2(dot(axis1, layer.texcoordU.xy), dot(axis1, layer.texcoordV.xy));
  return texcoords;
}

vec4 terrainLayerSample(uint textureIndex, uint samplerIndex, TerrainLayerTexcoords texcoords)
{
  return textures[nonuniformEXT(textureIndex)].SampleGrad(
    samplers[nonuniformEXT(samplerIndex)], texcoords.texcoord, texcoords.gradientX, texcoords.gradientY);
}

// Finds the chunk a world position lies over, among the few the position's grid cell names.
// A chunk covers 0..1 of its mask.
bool terrainLayersFindChunk(vec3 position, out TerrainLayerChunk chunk, out vec3 objectPosition, out vec2 maskTexcoord)
{
  objectPosition = vec3(0);
  maskTexcoord = vec2(0);

  const uint axis0 = cb.terrainLayerArgs.gridAxes & 0x3;
  const uint axis1 = (cb.terrainLayerArgs.gridAxes >> 2) & 0x3;
  const vec2 cell = floor(
    (vec2(position[axis0], position[axis1]) - cb.terrainLayerArgs.gridOrigin) / cb.terrainLayerArgs.gridCellSize);
  if (any(cell < 0.0) || cell.x >= float(cb.terrainLayerArgs.gridWidth) || cell.y >= float(cb.terrainLayerArgs.gridHeight))
  {
    return false;
  }

  const vec4 candidates = terrainLayerTableRead(uint(cell.y) * cb.terrainLayerArgs.gridWidth + uint(cell.x));

  for (uint i = 0; i < kMaxTerrainLayerGridCandidates; i++)
  {
    if (candidates[i] == 0.0)
    {
      break;
    }

    const uint texel = cb.terrainLayerArgs.chunkOffset + (uint(candidates[i]) - 1) * kTerrainLayerChunkTexels;
    chunk.worldToObject[0] = terrainLayerTableRead(texel);
    chunk.worldToObject[1] = terrainLayerTableRead(texel + 1);
    chunk.worldToObject[2] = terrainLayerTableRead(texel + 2);
    const vec4 projection = terrainLayerTableRead(texel + 3);
    chunk.projectionOrigin = projection.xyz;
    chunk.maskScale = projection.w;

    const vec3 candidate = terrainLayerChunkPoint(chunk, position);
    const vec2 texcoord = candidate.xz * chunk.maskScale;

    if (all(texcoord >= 0.0) && all(texcoord <= 1.0))
    {
      const vec4 range = terrainLayerTableRead(texel + 4);
      chunk.firstLayer = uint(range.x);
      chunk.layerCount = uint(range.y);
      objectPosition = candidate;
      maskTexcoord = texcoord;
      return true;
    }
  }

  return false;
}

TerrainLayerBlend terrainLayersEvaluate(SurfaceInteraction surfaceInteraction, MinimalRayInteraction minimalRayInteraction)
{
  TerrainLayerBlend blend;
  blend.valid = false;
  blend.albedo = vec3(0);
  blend.normal = surfaceInteraction.geometryNormal;
  blend.normalDetail = 0;
  blend.roughness = 0;
  blend.metallic = 0;

  TerrainLayerChunk chunk;
  vec3 objectPosition;
  vec2 maskTexcoord;
  if (!terrainLayersFindChunk(surfaceInteraction.position, chunk, objectPosition, maskTexcoord))
  {
    return blend;
  }

  const vec3 projectedPosition = objectPosition + chunk.projectionOrigin;

  // The ray cone's footprint on the surface, as two axes; see computeAnisotropicEllipseAxes.
  const vec3 triangleNormal = surfaceInteraction.geometryNormal;
  const vec3 coneDirection = -minimalRayInteraction.viewDirection;
  vec3 ellipseAxis0 = coneDirection - dot(triangleNormal, coneDirection) * triangleNormal;
  const vec3 planeProjection0 = ellipseAxis0 - dot(coneDirection, ellipseAxis0) * coneDirection;
  ellipseAxis0 *= minimalRayInteraction.coneRadius / max(0.0001, length(planeProjection0));
  vec3 ellipseAxis1 = cross(triangleNormal, ellipseAxis0);
  const vec3 planeProjection1 = ellipseAxis1 - dot(coneDirection, ellipseAxis1) * coneDirection;
  ellipseAxis1 *= minimalRayInteraction.coneRadius / max(0.0001, length(planeProjection1));
  const vec3 objectEllipseAxis0 = terrainLayerChunkDirection(chunk, ellipseAxis0);
  const vec3 objectEllipseAxis1 = terrainLayerChunkDirection(chunk, ellipseAxis1);

  // Composite the coverage in submission order, keeping the layers that weigh the most.
  uint keptLayer[kMaxTerrainLayersBlended];
  float keptWeight[kMaxTerrainLayersBlended];
  uint keptCount = 0;

  for (uint i = 0; i < chunk.layerCount; i++)
  {
    const uint layerIndex = chunk.firstLayer + i;
    const uint flags = terrainLayerFlagsRead(layerIndex);
    const float alphaReference = float(flags & TERRAIN_LAYER_ALPHA_REFERENCE_MASK) / 255.0;

    float coverage = 1.0;
    if (flags & TERRAIN_LAYER_FLAG_HAS_MASK)
    {
      coverage = textures[nonuniformEXT(terrainLayerMaskTextureRead(layerIndex))].SampleLevel(
        samplers[nonuniformEXT(cb.terrainLayerArgs.maskSamplerIndex)], maskTexcoord, 0).a;

      if ((flags & TERRAIN_LAYER_FLAG_COLOR_ALPHA_IN_COVERAGE) && coverage > alphaReference)
      {
        const TerrainLayer layer = terrainLayerRead(layerIndex);
        coverage *= terrainLayerSample(layer.colorTextureIndex, layer.samplerIndex,
          terrainLayerTexcoords(layer, projectedPosition, objectEllipseAxis0, objectEllipseAxis1)).a;
      }

      if (coverage <= alphaReference)
      {
        continue;
      }
    }

    uint lightest = 0;
    for (uint k = 0; k < keptCount; k++)
    {
      keptWeight[k] *= 1.0 - coverage;
      if (keptWeight[k] < keptWeight[lightest])
      {
        lightest = k;
      }
    }

    if (keptCount < kMaxTerrainLayersBlended)
    {
      lightest = keptCount++;
    }
    else if (coverage <= keptWeight[lightest])
    {
      continue;
    }

    keptLayer[lightest] = layerIndex;
    keptWeight[lightest] = coverage;
  }

  // Blend what is left.
  const vec3 geometryNormal = surfaceInteraction.geometryNormal;
  vec3 normal = vec3(0);
  float totalWeight = 0;

  for (uint k = 0; k < keptCount; k++)
  {
    const float weight = keptWeight[k];
    if (weight < cb.terrainLayerArgs.minBlendWeight)
    {
      continue;
    }

    const TerrainLayer layer = terrainLayerRead(keptLayer[k]);
    const TerrainLayerTexcoords texcoords = terrainLayerTexcoords(layer, projectedPosition, objectEllipseAxis0, objectEllipseAxis1);

    vec3 albedo = vec3(1);
    if (layer.colorTextureIndex != uint(BINDING_INDEX_INVALID))
    {
      albedo = terrainLayerSample(layer.colorTextureIndex, layer.samplerIndex, texcoords).rgb;
    }
    if (!(layer.flags & TERRAIN_LAYER_FLAG_COLOR_IS_LINEAR))
    {
      albedo = gammaToLinear(albedo);
    }

    vec3 layerNormal = geometryNormal;
    if (layer.normalTextureIndex != uint(BINDING_INDEX_INVALID))
    {
      const vec3 tangentNormal = unsignedOctahedralToHemisphereDirection(
        terrainLayerSample(layer.normalTextureIndex, layer.samplerIndex, texcoords).xy, cb.opaqueMaterialArgs.normalIntensity);

      // The layer's tangent frame: the directions its texture coordinates increase along, on the surface.
      const vec3 worldU = terrainLayerChunkGradient(chunk, terrainLayerUnproject(layer.flags, layer.texcoordU.xy));
      const vec3 worldV = terrainLayerChunkGradient(chunk, terrainLayerUnproject(layer.flags, layer.texcoordV.xy));
      const vec3 tangent = worldU - dot(worldU, geometryNormal) * geometryNormal;
      const vec3 bitangent = worldV - dot(worldV, geometryNormal) * geometryNormal;
      const float tangentLength = length(tangent);
      const float bitangentLength = length(bitangent);

      // A projection edge-on to the surface has no frame; such a layer carries next to no weight.
      if (tangentLength > 1e-6 && bitangentLength > 1e-6)
      {
        layerNormal = normalize(
          tangent / tangentLength * tangentNormal.x + bitangent / bitangentLength * tangentNormal.y + geometryNormal * tangentNormal.z);
      }
    }

    float roughness = float((layer.flags >> TERRAIN_LAYER_ROUGHNESS_SHIFT) & 0xFF) / 255.0;
    if (layer.roughnessTextureIndex != uint(BINDING_INDEX_INVALID))
    {
      roughness = terrainLayerSample(layer.roughnessTextureIndex, layer.samplerIndex, texcoords).x;
    }

    float metallic = float((layer.flags >> TERRAIN_LAYER_METALLIC_SHIFT) & 0xFF) / 255.0;
    if (layer.metallicTextureIndex != uint(BINDING_INDEX_INVALID))
    {
      metallic = terrainLayerSample(layer.metallicTextureIndex, layer.samplerIndex, texcoords).x;
    }

    blend.albedo += weight * albedo;
    blend.roughness += weight * roughness;
    blend.metallic += weight * metallic;
    normal += weight * layerNormal;
    totalWeight += weight;
  }

  if (totalWeight <= 0)
  {
    return blend;
  }

  blend.valid = true;
  blend.albedo /= totalWeight;
  blend.roughness /= totalWeight;
  blend.metallic /= totalWeight;
  blend.normal = normalize(normal);
  blend.normalDetail = saturate(1.0 - dot(blend.normal, geometryNormal));
  return blend;
}
